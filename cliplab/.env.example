# --- Obligatorias ---
MASTER_KEY=                 # mínimo 16 caracteres; sin ella el servidor no arranca
DATABASE_URL=               # referencia al Postgres de Railway
GEMINI_API_KEY_1=           # Copywriting y títulos de alto impacto
GEMINI_API_KEY_2=           # Auditoría y validación ortográfica
GEMINI_API_KEY_3=           # Análisis de transcripciones y extracción de fragmentos (obligatoria para analizar videos)
GEMINI_API_KEY_4=           # Respaldo y verificación cruzada (relevo si otra llave falla o se agota)

# --- Recomendadas ---
GEMINI_MODEL=gemini-3.5-flash   # por defecto ya es este; solo cámbialo si Google lo renombra
PUBLICAR_REAL=0             # 0 = modo prueba (llega hasta el botón final sin pulsarlo). 1 = publica de verdad
PROXY_URL=                  # opcional: http://usuario:clave@host:puerto (proxy residencial del mismo país)
CLIPS_DIR=/tmp/clips        # con Volume en /data: /data/clips
DATA_DIR=/tmp/cliplab-data  # con Volume en /data: /data (aquí van las capturas de evidencia)

# --- Ajustes opcionales ---
PGSSL=0                     # 1 solo si usas la URL pública de Postgres
CRF=23                      # calidad de video (18 mejor / 28 más liviano)
LOGO_PATH=                  # por defecto assets/logo.png (PNG con transparencia)
LOGO_ANCHO=130              # px sobre el lienzo 720x1280
LOGO_X=36                   # coordenadas fijas; se rechazan si pisan la interfaz (arriba 140px, abajo 340px, botones derecha)
LOGO_Y=150
LOGO_OPACIDAD=0.9
SUBTITULOS=1                # 0 = sin subtítulos
SUB_MAX_PALABRAS=3          # palabras por línea
SUB_MARGEN_V=360            # distancia del subtítulo al borde inferior (px del lienzo 720x1280)
SUB_TAMANO=64
SUB_IDIOMAS=es-orig,en-orig,es,en   # orden de preferencia de los subtítulos de YouTube
BORRAR_AL_PUBLICAR=1        # 1 = el MP4 se borra en cuanto se publica en todas las plataformas pedidas
MAX_CLIPS=8
CLIP_MIN_SEG=15
CLIP_MAX_SEG=90
REENCUADRE=blur             # blur = video centrado con fondo desenfocado | crop = recorte central
FFMPEG_THREADS=2
TTL_HORAS=48
MAX_DISK_MB=1500
YT_COOKIES=                 # ruta a cookies.txt si YouTube bloquea la descarga
HEADLESS=1
UPLOAD_TIMEOUT_MS=600000
HUMANO_FACTOR=1             # escala todas las pausas humanas (1 = normal; no lo bajes en producción)
TYPE_BUDGET_S=45            # tope de tiempo para teclear una descripción
TYPE_MIN_MS=50
TYPE_MAX_MS=180
CAPTION_MAX=600
PAUSA_MIN_S=20
PAUSA_MAX_S=60
MAX_PUB_DIA=10
FB_REELS_URL=https://www.facebook.com/reels/create
SESSION_KEY=                # opcional: llave aparte para cifrar sesiones (por defecto MASTER_KEY)

# --- Fase 4: lotes y reciclaje multi-ángulo ---
LOTE_TAMANO=10              # elementos por ciclo (se fuerza al rango 10-20)
LOTE_PAUSA_S=30             # pausa entre ciclos; el janitor corre al cerrar cada ciclo
LOTE_TICK_MS=5000           # cada cuánto el despachador revisa si toca un ciclo
LOTE_MAX_ITEMS=200          # máximo de elementos por lote de cortes
VARIANTES_MAX=20            # máximo de variantes por petición de reciclaje (1-20)
PROTEGER_HORAS=3            # el video base no se purga si una variante sale en menos de N horas
APLAZO_MIN=120              # minutos de espera si se alcanza el límite diario o el agente está ocupado
ZONA_PUBLICACION=America/Santo_Domingo   # zona de las ventanas horarias (HH:MM-HH:MM)
DB_POOL_MAX=8               # conexiones a Postgres (mínimo 5)
