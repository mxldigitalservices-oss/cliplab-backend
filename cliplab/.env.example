MASTER_KEY=              # OBLIGATORIA (mínimo 16 caracteres). Sin ella el servidor no arranca
DATABASE_URL=            # referencia al Postgres de Railway
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash   # verifica el modelo vigente
ALLOWED_ORIGIN=          # opcional: orígenes permitidos separados por coma
PUBLIC_URL=https://tu-backend.up.railway.app
YT_COOKIES=              # opcional: ruta a cookies.txt si YouTube bloquea la descarga
YT_CLIENT_ID=  YT_CLIENT_SECRET=  YT_REFRESH_TOKEN=  YT_PRIVACY=private
TIKTOK_ACCESS_TOKEN=  TIKTOK_PRIVACY=SELF_ONLY
IG_USER_ID=  IG_ACCESS_TOKEN=  GRAPH_VERSION=v21.0
