# --- Obligatorias ---
MASTER_KEY=                 # mínimo 16 caracteres; sin ella el servidor no arranca
DATABASE_URL=               # referencia al Postgres de Railway
GEMINI_API_KEYS=            # una o varias llaves separadas por coma (rotación automática)

# --- Recomendadas ---
GEMINI_MODEL=gemini-2.5-flash   # verifica el modelo vigente en la documentación de Google
PUBLICAR_REAL=0             # 0 = modo prueba (llega hasta el botón final sin pulsarlo). 1 = publica de verdad
PROXY_URL=                  # opcional: http://usuario:clave@host:puerto (proxy residencial del mismo país)
CLIPS_DIR=/tmp/clips        # con Volume en /data: /data/clips
DATA_DIR=/tmp/cliplab-data  # con Volume en /data: /data (aquí van las capturas de evidencia)

# --- Ajustes opcionales ---
MAX_CLIPS=8
CLIP_MIN_SEG=15
CLIP_MAX_SEG=90
REENCUADRE=blur             # blur = video centrado con fondo desenfocado | crop = recorte central
FFMPEG_THREADS=2
TTL_HORAS=48
MAX_DISK_MB=1500
YT_COOKIES=                 # ruta a cookies.txt si YouTube bloquea la descarga
HEADLESS=1
UPLOAD_TIMEOUT_MS=600000
TYPE_MIN_MS=50
TYPE_MAX_MS=180
CAPTION_MAX=600
PAUSA_MIN_S=20
PAUSA_MAX_S=60
MAX_PUB_DIA=10
FB_REELS_URL=https://www.facebook.com/reels/create
SESSION_KEY=                # opcional: llave aparte para cifrar sesiones (por defecto MASTER_KEY)
