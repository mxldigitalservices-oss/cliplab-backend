NODE_ENV=development
PORT=8080
LOG_LEVEL=info
CORS_ORIGIN=*
MASTER_KEY=cambia-esta-llave
# Carpeta temporal. Vacia = <temporal del sistema>/cliplab (Windows: %TEMP%\cliplab). No hace falta fijarla.
TMP_DIR=

FFMPEG_PATH=ffmpeg
YTDLP_PATH=yt-dlp
YTDLP_COOKIES=
WHISPER_PATH=whisper-cli
WHISPER_MODEL=/opt/whisper/modelo.bin
WHISPER_LANG=auto

FONTS_DIR=
SUBTITLE_FONT=Anton

CPU_THREADS=2
VIDEO_CRF=24
VIDEO_PRESET=veryfast
MAX_VIDEO_SECONDS=10800
MAX_CLIP_SECONDS=90

FFPROBE_PATH=ffprobe
LOGO_ENABLED=true
LOGO_PATH=
LOGO_POSITION=top-right
LOGO_WIDTH=216
LOGO_MARGIN=56
LOGO_OPACITY=0.95

# Extraccion multiple (4-5 clips de 30-60 s por video) y anti-duplicados
# DATA_DIR guarda historial-cortes.json. En Railway usa un volumen (RAILWAY_VOLUME_MOUNT_PATH) para que sobreviva a los deploys.
DATA_DIR=
SEGMENT_MIN_SECONDS=30
SEGMENT_MAX_SECONDS=60
SEGMENTS_MIN=4
SEGMENTS_MAX=5

# Publicador ("Programar y Publicar")
# MongoDB (cola de publicaciones). Con el plugin de MongoDB de Railway basta con referenciar MONGO_URL en este servicio:
#   MONGO_URL=${{MongoDB.MONGO_URL}}      (tambien se aceptan MONGODB_URI, MONGO_PUBLIC_URL o MONGOHOST/MONGOUSER/MONGOPASSWORD)
# Sin URI o si Mongo falla, la cola se guarda en DATA_DIR/programador.json (con volumen persiste entre deploys).
MONGODB_URI=
MONGODB_DB=cliplab
MONGO_REINTENTO_MS=300000
# Chromium para publicar (la imagen ya lo instala en /ms-playwright; no hace falta tocarlo)
PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
# PUBLICADOR_MODO=seco   -> recorre el flujo sin publicar de verdad (pruebas)

# ---------------------------------------------------------------------------
# En Vivo: deteccion automatica por contenido (tension_reality / chisme_confidencia)
# Con auto activado, cada vez que se completan segmentos se transcribe la cola reciente (whisper local, 1 a la vez) y se puntua
# con el cerebro. Sin whisper/modelo, o con ENVIVO_ASR=off, se usa solo el volumen. Pensado para 16 GB de RAM / 4 hilos.
# ---------------------------------------------------------------------------
ENVIVO_ASR=on                 # off = solo volumen
ENVIVO_ANALISIS_SEG=40        # ventana de la cola reciente que se transcribe
ENVIVO_INTENSIDAD_MIN=50      # intensidad (0-100) para disparar solo con el texto
ENVIVO_INTENSIDAD_REFUERZO=30 # intensidad suficiente si el audio lo confirma (pico de volumen; voz baja en chismes)
ENVIVO_CANTIDAD=5             # cortes automaticos por sesion (0 = sin tope). Tambien se puede enviar {cantidad} a /iniciar y /auto
ENVIVO_MAX_PENDIENTES=2       # trabajos en cola (render en curso + 1 esperando) antes de pausar la deteccion
ENVIVO_ASR_HILOS=2            # hilos de whisper (el render usa CPU_THREADS)
ENVIVO_DURACION_AUTO=55       # segundos de cada corte automatico (el pipeline lo ajusta a frases completas)
ENVIVO_COOLDOWN_SEG=90        # separacion minima entre cortes automaticos
ENVIVO_UMBRAL_DB=6            # pico de volumen sobre la mediana reciente

# ---------------------------------------------------------------------------
# Windows (PowerShell), sin Docker ni Railway
#   1) Instala Node 20+, FFmpeg y yt-dlp (winget install Gyan.FFmpeg yt-dlp.yt-dlp) y deja ffmpeg.exe / ffprobe.exe / yt-dlp.exe en el PATH.
#   2) whisper.cpp: descarga whisper-cli.exe y un modelo ggml (recomendado base o tiny-q5_1 para directos) y apunta aqui:
#        WHISPER_PATH=C:\herramientas\whisper\whisper-cli.exe
#        WHISPER_MODEL=C:\herramientas\whisper\ggml-base-q5_1.bin
#      (sin definir WHISPER_MODEL se busca <proyecto>\models\whisper\modelo.bin)
#   3) Copia este archivo a .env, ajusta MASTER_KEY y arranca con:  npm run start:local
#   Equivalentes: FFMPEG_PATH / FFPROBE_PATH / YTDLP_PATH aceptan rutas completas (con espacios, sin comillas).
#   Laptop 16 GB / 4 hilos sugerido:  CPU_THREADS=2  ENVIVO_ASR_HILOS=2  MAX_QUEUE=6  VIDEO_PRESET=veryfast
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# En Vivo por BLOQUES (PC local 16 GB + Ollama)
#   ENVIVO_BLOQUES=on arranca todas las sesiones en modo bloques (o envia {"bloques":true} a /api/envivo/iniciar).
#   Cada ENVIVO_BLOQUE_SEG segundos de directo se congelan como un mp4 y entran a la cola como video normal: whisper
#   una sola vez, el curador elige hasta ENVIVO_BLOQUE_CLIPS cortes y los que el cerebro marca "descartar" se omiten
#   ANTES de renderizar. Mientras se procesa un bloque, el grabador sigue guardando el siguiente.
# ---------------------------------------------------------------------------
ENVIVO_BLOQUES=on
ENVIVO_BLOQUE_SEG=360
ENVIVO_BLOQUE_CLIPS=3
# Ollama: el tope viejo de 4 s hacia que SIEMPRE cayera al motor heuristico. Ahora 25 s (maximo 120 s).
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_MS=25000
OLLAMA_KEEP_ALIVE=30m

# ---------------------------------------------------------------------------
# Instagram oficial (Meta Graph API) + series de 60 s + Ollama en Railway
# ---------------------------------------------------------------------------
IG_ACCESS_TOKEN=
IG_USER_ID=
META_APP_ID=
META_APP_SECRET=
IG_CROSSPOST_FACEBOOK=on
PUBLIC_BASE_URL=https://cliplab-backend-production.up.railway.app
SERIES_INTERVALO_MIN=30
SERIES_MAX_DIA=20
LIMPIAR_TRAS_PUBLICAR=on
CLIPS_TTL_H=72
# Ollama por la red privada de Railway (servicio ollama-core-engine2):
OLLAMA_URL=http://ollama-core-engine2.railway.internal:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_MS=60000
